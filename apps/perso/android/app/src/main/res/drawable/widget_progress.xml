<?xml version="1.0" encoding="utf-8"?>
<!-- Barre de progression des tuiles Calories/Pas/Eau du widget : fond relief, remplissage citron.
     La couleur du remplissage est remplacée par DashboardWidgetProvider (mêmes règles que l'app). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="#22221f" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="#d7ff3f" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
