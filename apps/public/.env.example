# Copier ce fichier vers .env.local (jamais committé, voir .gitignore) et renseigner les
# vraies valeurs depuis Supabase → Project Settings → API Keys.
#
# VITE_SUPABASE_URL : "Project URL" de base, SANS le "/rest/v1/" à la fin
#   (ex. https://xxxxx.supabase.co)
# VITE_SUPABASE_ANON_KEY : la clé "Publishable key" (sb_publishable_...), PAS la clé
#   "Secret key" (sb_secret_...) — celle-ci ne doit jamais figurer dans un fichier .env
#   utilisé côté client.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
